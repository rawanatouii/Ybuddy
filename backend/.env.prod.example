# Copy to backend/.env on the server and fill in real values. Never commit the real .env.
#
# DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD, DB_DATABASE are injected by
# docker-compose.prod.yml from the root .env — do not set them here, they'd
# be overridden anyway.

# ── Compte admin auto-seedé au premier démarrage (si DB vide) ──────────────────
# This account is created automatically on first boot against an empty DB.
# Log in with it once, then consider disabling/rotating it.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE

# ── Authentification JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Use a DIFFERENT secret than your local dev .env.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_VALUE

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
