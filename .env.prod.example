# Copy this file to ".env" on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit the real .env.
#
# Generate strong random passwords with, e.g.:
#   openssl rand -hex 24

DOMAIN=your-domain.com

DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
DB_USERNAME=ybuddy
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
DB_DATABASE=ybuddy_db
